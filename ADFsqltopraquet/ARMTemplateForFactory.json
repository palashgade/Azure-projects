{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFsqltopraquet"
		},
		"SQLSERVER_SP_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQLSERVER_SP'"
		},
		"SQLSERVER_SP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "PALASHLAPTOP\\SQLEXPRESS"
		},
		"SQLSERVER_SP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"SQLSERVER_SP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_SQL_SP')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "SP_SQL_SQL",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[InsertCustomer]",
							"storedProcedureParameters": {
								"CustomerID": {
									"value": "1",
									"type": "Int32"
								},
								"FirstName": {
									"value": "PaluVaishu",
									"type": "String"
								},
								"LastName": {
									"value": "Gade",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "SQLSERVER_SP",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/SQLSERVER_SP')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SQLSERVER_SP')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('SQLSERVER_SP_properties_typeProperties_server')]",
					"database": "[parameters('SQLSERVER_SP_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('SQLSERVER_SP_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SQLSERVER_SP_password')]"
					}
				},
				"connectVia": {
					"referenceName": "SPintegrationRuntime1",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/SPintegrationRuntime1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SPintegrationRuntime1')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		}
	]
}